{
  "name": "matsubo.github.io",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "matsubo.github.io",
  "author": "Yuki Matsukura",
  "keywords": [
    "astro",
    "portfolio",
    "typescript"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "astro build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "coverage": "vitest run --project unit --coverage",
    "lint:ci": "biome ci ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@iconify-json/heroicons": "^1.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "astro-icon": "^1.1.5",
    "daisyui": "^5.6.16",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
